<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Swag Labs Automation Suite" verbose="1" parallel="false">

    <listeners>
        <listener class-name="Listeners.CustomeExecutionListener"/>
        <listener class-name="Listeners.CustomTestListener"/>
    </listeners>

    <!-- Smoke Tests -->
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>

        <classes>
            <class name="Tests.LoginTest"/>
            <class name="Tests.InventoryTest"/>
        </classes>
    </test>

    <!-- Regression Tests -->
    <test name="Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>

        <classes>
            <class name="Tests.LoginTest"/>
            <class name="Tests.InventoryTest"/>
        </classes>
    </test>

</suite>